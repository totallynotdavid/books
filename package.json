{
  "name": "@totallynotdavid/books",
  "version": "0.0.2",
  "description": "Download books. Simple as that.",
  "keywords": [
    "books",
    "downloader",
    "libgen"
  ],
  "bugs": {
    "url": "https://github.com/totallynotdavid/books/issues"
  },
  "license": "MIT",
  "author": "David Duran <dadch1404@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totallynotdavid/books.git"
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bunup --minify",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "fix": "biome check --write . && oxfmt '**/*.{md,yml,json}'",
    "lint": "biome check . && oxfmt --check '**/*.{md,yml,json}'",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "bunup": "^0.16.32",
    "oxfmt": "^0.73.0",
    "typescript": "^7.0.2"
  }
}
